# PostgreSQL (docker-compose.yml ile uyumlu)
DATABASE_URL="postgresql://tedarik:tedarik@localhost:5432/tedarik_crm?schema=public"

# Auth.js gizli anahtarı. Üretmek için:  npx auth secret   veya   openssl rand -base64 32
AUTH_SECRET=""

# Sadece `npm run db:seed` için: ilk yönetici hesabı
SEED_ADMIN_EMAIL="admin@ornek.com"
SEED_ADMIN_PASSWORD="degistir-beni-123"
SEED_ADMIN_NAME="Sistem Yöneticisi"

# Panelde tarihlerin gösterileceği saat dilimi
APP_TIMEZONE="Europe/Istanbul"

# --- Canlı (sunucu) ortamı için, sunucunun ortam değişkenlerine girilir ---
# DATABASE_URL="postgresql://KULLANICI:SIFRE@DB_HOST:5432/DB_ADI?schema=public&sslmode=require"
# AUTH_SECRET="<canlıya özel, yerelden farklı uzun rastgele değer>"
# AUTH_URL="https://alanadiniz.com"     # sitenin genel adresi
# AUTH_TRUST_HOST="true"                # reverse proxy (nginx, Cloudflare, vb.) arkasındaysa

