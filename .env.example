# MariaDB / MySQL (docker-compose.yml ile uyumlu)
DATABASE_URL="mysql://tedarik:tedarik@localhost:3306/tedarik_crm"

# Auth.js gizli anahtarı. Üretmek için:  npx auth secret   veya   openssl rand -base64 32
AUTH_SECRET=""

# Sadece `npm run db:seed` için: ilk yönetici hesabı
SEED_ADMIN_EMAIL="admin@ornek.com"
SEED_ADMIN_PASSWORD="degistir-beni-123"
SEED_ADMIN_NAME="Sistem Yöneticisi"

# Panelde tarihlerin gösterileceği saat dilimi
APP_TIMEZONE="Europe/Istanbul"

# --- Canlı ortam (cPanel > Setup Node.js App > Environment variables) ---
# DATABASE_URL="mysql://tusbanak_crm:<şifre>@localhost:3306/tusbanak_crm"
# AUTH_SECRET="<canlıya özel, yerelden farklı uzun rastgele değer>"
# AUTH_URL="https://tusbacrm.tusbanakis.com"
# AUTH_TRUST_HOST="true"
# APP_TIMEZONE="Europe/Istanbul"
# CRON_SECRET="<uzun rastgele değer; cPanel cron komutundaki Bearer değeriyle aynı>"
